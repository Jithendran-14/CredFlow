# Copy to .env; never commit a filled file.
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORCHESTRATION_DB_USER=CF_ORCHESTRATION
ORCHESTRATION_DB_PASSWORD=REPLACE_WITH_ORACLE_PASSWORD
INTEGRATION_DB_USER=CF_LENDER_INTEGRATION
INTEGRATION_DB_PASSWORD=REPLACE_WITH_ORACLE_PASSWORD
BANK_A_DB_USER=CF_SIM_BANK_A
BANK_A_DB_PASSWORD=REPLACE_WITH_ORACLE_PASSWORD
NBFC_B_DB_USER=CF_SIM_NBFC_B
NBFC_B_DB_PASSWORD=REPLACE_WITH_ORACLE_PASSWORD

# Member 1 Auth uses8085. Obtain its actual issuer/audience/public settings.
# Choose EXACTLY ONE: a confirmed JWKS URL OR an RSA public PEM resource.
AUTH_ISSUER=REPLACE_WITH_ISSUER_CLAIM
JWT_AUDIENCE=REPLACE_WITH_AUDIENCE_CLAIM
JWT_JWKS_URI=REPLACE_WITH_CONFIRMED_JWKS_URL
JWT_PUBLIC_KEY_LOCATION=
JWT_ROLE_MODE=FLAT
JWT_ROLE_CLAIM=roles
# PEM example: file:C:/CredFlowKeys/auth-public.pem
# Clear JWT_JWKS_URI before selecting JWT_PUBLIC_KEY_LOCATION.
# KEYCLOAK role mode is optional and must be selected explicitly.
UI_CLIENT_ID=credflow-ui

# Dedicated machine grants are not implemented by Member1 yet.
# Set a scoped client-credentials URL only after the owner supplies it.
# Do not enter an ADMIN login URL, seller token or private key here.
OAUTH_TOKEN_URL=
ORCHESTRATION_CLIENT_SECRET=
INTEGRATION_CLIENT_SECRET=
BANK_A_CALLBACK_SECRET=
NBFC_B_CALLBACK_SECRET=

FRONTEND_ORIGINS=http://localhost:5173
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APPLICATION_URL=http://localhost:8081
# Consent/Verification port8082 remains proposed in Member1 contract.
CONSENT_URL=http://localhost:8082
ELIGIBILITY_URL=http://localhost:8083
ORCHESTRATION_URL=http://localhost:8084
INTEGRATION_PORT=8087
INTEGRATION_URL=http://localhost:8087
# Independent lender processes; 8090 remains available for upstream provider mocks.
BANK_A_URL=http://localhost:8091
NBFC_B_URL=http://localhost:8092
BANK_A_PORT=8091
NBFC_B_PORT=8092
# Optional independent database endpoints; both otherwise use ORACLE_URL.
# BANK_A_ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# NBFC_B_ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# M3->Consent trigger is a pending extension, distinct from provider APIs.
CONSENT_VERIFICATION_PATH=/api/v1/internal/verifications
BANK_A_LENDER_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1
NBFC_B_LENDER_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb2
BANK_A_PRODUCT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1
NBFC_B_PRODUCT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa2
