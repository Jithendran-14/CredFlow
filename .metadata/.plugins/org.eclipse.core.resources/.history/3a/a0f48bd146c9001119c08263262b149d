spring.config.import=classpath:member3-defaults.properties

server.port=${INTEGRATION_PORT:8087}
spring.application.name=lender-integration-service
credflow.service-name=lender-integration-service

spring.datasource.username=${INTEGRATION_DB_USER:CF_LENDER_INTEGRATION}
spring.datasource.password=${INTEGRATION_DB_PASSWORD}

credflow.default-client-id=integration-service
credflow.default-client-secret=${INTEGRATION_CLIENT_SECRET:}

credflow.oauth.clients.orchestration.client-id=integration-service
credflow.oauth.clients.orchestration.client-secret=${INTEGRATION_CLIENT_SECRET:}

credflow.oauth.clients.simulator.client-id=integration-service
credflow.oauth.clients.simulator.client-secret=${INTEGRATION_CLIENT_SECRET:}

credflow.lenders.bank-a-callback-client=mock-bank-a
credflow.lenders.nbfc-b-callback-client=mock-nbfc-b

credflow.topics=loan.offer.accepted,loan.offer.declined
