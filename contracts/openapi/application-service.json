{
  "openapi": "3.0.3",
  "info": {
    "title": "application-service implemented foundation API",
    "version": "0.1.0",
    "description": "Only implemented endpoints. Planned business flow is documented in ../day6-flow.md."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/system/application-service/info": {
      "get": {
        "responses": {
          "200": {
            "description": "Authenticated foundation metadata"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Unhealthy"
          }
        }
      }
    },
    "/api/v1/applications": {
      "post": {
        "summary": "Submit a completed marketplace application",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Invalid input/key"
          },
          "401": {
            "description": "Invalid or absent token"
          },
          "403": {
            "description": "Role or marketplace mismatch"
          },
          "404": {
            "description": "Seller not registered"
          },
          "409": {
            "description": "Payload/key/active-application conflict"
          },
          "201": {
            "description": "Created, or replay of the same key and typed request. Location identifies the same resource.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}": {
      "get": {
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned/permitted application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationView"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role denied"
          },
          "404": {
            "description": "Absent or inaccessible application"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApplicationRequest": {
        "type": "object",
        "required": [
          "marketplaceId",
          "marketplaceSellerId",
          "marketplaceRequestId",
          "requestedAmount",
          "currency",
          "loanPurpose",
          "businessProfile",
          "sellerRequestReference",
          "initialSharingConsent"
        ],
        "properties": {
          "marketplaceId": {
            "type": "string",
            "format": "uuid"
          },
          "marketplaceSellerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "marketplaceRequestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "requestedAmount": {
            "type": "string",
            "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
          },
          "currency": {
            "enum": [
              "INR"
            ]
          },
          "loanPurpose": {
            "enum": [
              "PURCHASE_INVENTORY",
              "WORKING_CAPITAL",
              "BUSINESS_EXPANSION"
            ]
          },
          "sellerRequestReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "businessProfile": {
            "type": "object",
            "required": [
              "displayName",
              "businessName",
              "businessStartDate"
            ],
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "businessName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "businessStartDate": {
                "type": "string",
                "format": "date",
                "description": "Must not be in the future"
              }
            }
          },
          "initialSharingConsent": {
            "type": "object",
            "required": [
              "scope",
              "noticeVersion",
              "authorisedAt",
              "evidenceReference"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "APPLICATION_SHARE_WITH_CREDFLOW"
                ]
              },
              "noticeVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "authorisedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Must not be in the future"
              },
              "evidenceReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        }
      },
      "ApplicationView": {
        "type": "object",
        "required": [
          "applicationId",
          "applicationReference",
          "sellerId",
          "marketplaceId",
          "requestedAmount",
          "currency",
          "loanPurpose",
          "status",
          "applicationRevision",
          "version",
          "workflowVersion"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "sellerId": {
            "type": "string",
            "format": "uuid"
          },
          "marketplaceId": {
            "type": "string",
            "format": "uuid"
          },
          "applicationReference": {
            "type": "string"
          },
          "requestedAmount": {
            "type": "string",
            "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
          },
          "currency": {
            "enum": [
              "INR"
            ]
          },
          "loanPurpose": {
            "enum": [
              "WORKING_CAPITAL",
              "PURCHASE_INVENTORY",
              "BUSINESS_EXPANSION"
            ]
          },
          "status": {
            "type": "string"
          },
          "applicationRevision": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "workflowVersion": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "BusinessError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId",
          "fieldErrors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
